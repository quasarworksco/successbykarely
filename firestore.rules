rules_version = '2';

// ============================================================================
// Success by Karely — Reglas de seguridad de Cloud Firestore (versión final)
// Roles (admins/{uid}.role):
//   owner  → todo, incluido equipo y registro de actividad
//   staff  → clientes, CRM, leads, mensajes, documentos y tareas
//   editor → blog, cursos, imágenes del sitio, testimonios y anuncios
// Todo lo que no aparece aquí queda DENEGADO.
// Pruébalas en Firebase > Firestore > Reglas > Simulador (ver README).
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones de apoyo ----------
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function adminDoc() {
      return /databases/$(database)/documents/admins/$(request.auth.uid);
    }
    // Rol del administrador actual (owner | staff | editor)
    function role() {
      return get(adminDoc()).data.role;
    }
    // Cualquier rol de administración
    function isAdmin() {
      return signedIn() && exists(adminDoc());
    }
    function isOwnerRole() {
      return isAdmin() && role() == 'owner';
    }
    // owner o staff: clientes, leads, mensajes, documentos
    function isStaff() {
      return isAdmin() && role() in ['owner', 'staff'];
    }
    // owner o editor: blog, cursos, imágenes, testimonios, anuncios
    function isEditor() {
      return isAdmin() && role() in ['owner', 'editor'];
    }

    // Texto opcional: si existe, debe ser string con longitud máxima
    function optStr(d, campo, max) {
      return !(campo in d) || (d[campo] is string && d[campo].size() <= max);
    }
    function reqStr(d, campo, min, max) {
      return campo in d && d[campo] is string && d[campo].size() >= min && d[campo].size() <= max;
    }
    function soloCambian(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }
    function serviciosValidos(lista) {
      return lista is list && lista.size() <= 7
        && lista.hasOnly(['universidad', 'carrera', 'equivalencia', 'credito_personal',
                          'credito_empresa', 'empresa', 'toolkits']);
    }

    // ---------- Administradores ----------
    match /admins/{uid} {
      // Cada admin lee su propio documento (para saber su rol); el owner lee todos
      allow read: if isOwner(uid) || isOwnerRole();
      allow create, update: if isOwnerRole()
        && request.resource.data.role in ['owner', 'staff', 'editor']
        && reqStr(request.resource.data, 'name', 1, 80)
        && reqStr(request.resource.data, 'email', 3, 120);
      // El owner no puede quitarse a sí mismo (evita quedarse sin dueño)
      allow delete: if isOwnerRole() && request.auth.uid != uid;
    }

    // ---------- Leads (formulario de contacto y boletín) ----------
    function validLead(d) {
      return d.keys().hasOnly([
          'firstName', 'lastName', 'email', 'phone', 'country', 'state', 'services',
          'message', 'referral', 'language', 'source', 'status', 'consent', 'createdAt'
        ])
        && d.keys().hasAll(['email', 'language', 'source', 'status', 'consent', 'createdAt'])
        && reqStr(d, 'email', 5, 120)
        && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}$')
        && optStr(d, 'firstName', 60)
        && optStr(d, 'lastName', 60)
        && optStr(d, 'phone', 30)
        && optStr(d, 'country', 60)
        && optStr(d, 'state', 60)
        && optStr(d, 'message', 2000)
        && optStr(d, 'referral', 40)
        && (!('services' in d) || serviciosValidos(d.services))
        && d.language in ['es', 'en']
        && d.source in ['landing', 'blog-newsletter']
        && d.status == 'nuevo'
        && d.consent == true
        && d.createdAt == request.time;
    }

    match /leads/{leadId} {
      allow create: if validLead(request.resource.data);
      allow read, update: if isStaff();
      allow delete: if isOwnerRole();

      match /notes/{noteId} {
        allow read, create: if isStaff();
        allow update, delete: if isOwnerRole();
      }
    }

    // ---------- Clientes (users) ----------
    // Campos que el propio cliente puede escribir en su perfil
    function camposPerfil() {
      return ['firstName', 'lastName', 'phone', 'country', 'state', 'city', 'language',
              'birthDate', 'situation', 'services', 'referral', 'consentMarketing', 'theme',
              'onboardingDone', 'focusStage', 'streak', 'lastStudyDate', 'lastActiveAt', 'updatedAt'];
    }
    function validPerfil(d) {
      return reqStr(d, 'firstName', 1, 60)
        && reqStr(d, 'lastName', 1, 60)
        && reqStr(d, 'phone', 7, 30)
        && optStr(d, 'country', 60)
        && optStr(d, 'state', 60)
        && optStr(d, 'city', 60)
        && d.language in ['es', 'en']
        && (!('birthDate' in d) || (d.birthDate is string && (d.birthDate == ''
            || d.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))))
        && d.situation in ['', 'estudiante', 'padre', 'profesional', 'emprendedor', 'otro']
        && serviciosValidos(d.services)
        && optStr(d, 'referral', 40)
        && d.consentMarketing is bool
        && d.theme in ['claro', 'oscuro', 'sistema']
        && d.onboardingDone is bool
        && (!('focusStage' in d) || (d.focusStage is int && d.focusStage >= 1 && d.focusStage <= 4))
        && d.streak is int && d.streak >= 0 && d.streak <= 5000
        && optStr(d, 'lastStudyDate', 10);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isStaff();

      // Alta: solo el propio usuario, con su correo real y fechas del servidor
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(camposPerfil().concat(['email', 'acceptedTermsAt', 'createdAt']))
        && validPerfil(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.onboardingDone == false
        && request.resource.data.streak == 0
        && request.resource.data.acceptedTermsAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastActiveAt == request.time;

      // Edición del cliente: solo sus campos de perfil (nunca correo ni fechas de alta)
      allow update: if (isOwner(uid)
          && soloCambian(camposPerfil())
          && validPerfil(request.resource.data)
          && request.resource.data.updatedAt == request.time)
        || isStaff();

      allow delete: if isOwnerRole();

      // Progreso por curso: el cliente solo guarda lecciones completadas y la última vista
      match /progress/{courseId} {
        allow read: if isOwner(uid) || isStaff() || isEditor();
        allow create, update: if (isOwner(uid)
            && request.resource.data.keys().hasOnly(['completed', 'lastLessonId', 'updatedAt'])
            && request.resource.data.completed is list
            && request.resource.data.completed.size() <= 500
            && reqStr(request.resource.data, 'lastLessonId', 0, 60)
            && request.resource.data.updatedAt == request.time)
          || isStaff();
        allow delete: if isStaff();
      }

      // Plan de acción: el equipo crea tareas; el cliente solo marca "hecho"
      match /tasks/{taskId} {
        allow read: if isOwner(uid) || isStaff();
        allow update: if (isOwner(uid) && soloCambian(['done']) && request.resource.data.done is bool)
          || isStaff();
        allow create, delete: if isStaff()
          && (request.method == 'delete' || (reqStr(request.resource.data, 'title', 1, 200)
              && optStr(request.resource.data, 'detail', 2000)));
      }

      // Documentos: el cliente sube y lee los suyos; nunca cambia estado ni comentario
      match /documents/{docId} {
        allow read: if isOwner(uid) || isStaff();
        allow create: if (isOwner(uid)
            && request.resource.data.keys().hasOnly(['name', 'url', 'publicId', 'format', 'bytes',
                                                     'uploadedBy', 'status', 'adminComment', 'createdAt'])
            && reqStr(request.resource.data, 'name', 1, 160)
            && reqStr(request.resource.data, 'url', 12, 600)
            && request.resource.data.url.matches('^https://res\\.cloudinary\\.com/.*')
            && optStr(request.resource.data, 'publicId', 300)
            && optStr(request.resource.data, 'format', 10)
            && request.resource.data.bytes is int
            && request.resource.data.bytes <= 10485760
            && request.resource.data.uploadedBy == 'client'
            && request.resource.data.status == 'recibido'
            && request.resource.data.adminComment == ''
            && request.resource.data.createdAt == request.time)
          || (isStaff() && request.resource.data.uploadedBy == 'admin');
        allow update: if isStaff()
          && request.resource.data.status in ['recibido', 'revision', 'aprobado', 'correccion'];
        allow delete: if isStaff();
      }
    }

    // ---------- CRM (etapa, etiquetas, notas internas): nunca visible para el cliente ----------
    match /crm/{uid} {
      allow read, write: if isStaff();

      match /notes/{noteId} {
        allow read, create: if isStaff();
        allow update, delete: if isOwnerRole();
      }
    }

    // ---------- Chats ----------
    match /chats/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['clientName', 'lastMessage', 'updatedAt', 'unreadByAdmin', 'unreadByClient'])
        && reqStr(request.resource.data, 'clientName', 1, 130)
        && request.resource.data.lastMessage == ''
        && request.resource.data.unreadByAdmin == 0
        && request.resource.data.unreadByClient == 0
        && request.resource.data.updatedAt == request.time;
      // El cliente: al enviar suma 1 a "sin leer por el equipo"; al leer pone sus no leídos en 0
      allow update: if isStaff()
        || (isOwner(uid)
            && soloCambian(['lastMessage', 'updatedAt', 'unreadByAdmin', 'clientName'])
            && reqStr(request.resource.data, 'lastMessage', 1, 140)
            && reqStr(request.resource.data, 'clientName', 1, 130)
            && request.resource.data.updatedAt == request.time
            && request.resource.data.unreadByAdmin == resource.data.get('unreadByAdmin', 0) + 1)
        || (isOwner(uid) && soloCambian(['unreadByClient']) && request.resource.data.unreadByClient == 0);

      // Mensajes: nadie edita ni borra mensajes (ni propios ni ajenos)
      match /messages/{msgId} {
        allow read: if isOwner(uid) || isStaff();
        allow create: if request.resource.data.keys().hasOnly(['text', 'from', 'authorName', 'createdAt'])
          && reqStr(request.resource.data, 'text', 1, 2000)
          && reqStr(request.resource.data, 'authorName', 1, 130)
          && request.resource.data.createdAt == request.time
          && ((isOwner(uid) && request.resource.data.from == 'client')
              || (isStaff() && request.resource.data.from == 'admin'));
        allow update, delete: if false;
      }
    }

    // ---------- Cursos ----------
    match /courses/{courseId} {
      // Clientes con sesión: cursos publicados para todos o asignados a ellos
      allow read: if isAdmin()
        || (signedIn() && resource.data.published == true
            && (resource.data.access == 'todos' || request.auth.uid in resource.data.allowedUids));
      allow create, delete: if isEditor();
      // El editor edita todo; el staff solo asigna clientes desde el CRM
      allow update: if isEditor() || (isStaff() && soloCambian(['allowedUids', 'updatedAt']));
    }

    // ---------- Anuncios y testimonios ----------
    match /announcements/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isEditor();
    }

    match /testimonials/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isEditor();
    }

    // ---------- Imágenes del sitio ----------
    match /siteMedia/{espacioId} {
      allow read: if true;
      allow write: if isEditor();

      match /items/{itemId} {
        allow read: if true;
        allow write: if isEditor();
      }
    }

    // ---------- Blog ----------
    match /postCategories/{id} {
      allow read: if true;
      allow write: if isEditor();
    }

    // Visible: publicado o programado y ya en fecha (los programados se publican solos)
    function postVisible(d) {
      return d.status in ['publicado', 'programado'] && d.publishAt <= request.time;
    }

    match /posts/{postId} {
      // Título, portada y extracto son públicos cuando el artículo es visible,
      // también en los "solo miembros": su cuerpo vive en privado/cuerpo.
      allow read: if isEditor() || postVisible(resource.data);

      // Contador de lecturas: cualquiera suma exactamente 1 y no toca nada más
      allow update: if isEditor()
        || (postVisible(resource.data)
            && soloCambian(['views'])
            && request.resource.data.views == resource.data.get('views', 0) + 1);

      allow create, delete: if isEditor();

      // Cuerpo de los artículos "Solo miembros": solo con sesión iniciada
      match /privado/{docId} {
        allow read: if isEditor()
          || (signedIn() && postVisible(get(/databases/$(database)/documents/posts/$(postId)).data));
        allow write: if isEditor();
      }

      // Historial de versiones del editor
      match /versions/{versionId} {
        allow read, write: if isEditor();
      }
    }

    // ---------- Registro de actividad (solo se agrega; nunca se edita ni se borra) ----------
    match /auditLog/{id} {
      allow read: if isOwnerRole();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'action', 'collection', 'docId', 'summary', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && reqStr(request.resource.data, 'action', 1, 40)
        && optStr(request.resource.data, 'summary', 300)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
